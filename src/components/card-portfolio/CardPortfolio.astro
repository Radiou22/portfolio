---
import './card-portfolio.css';
import "../../styles/global.css"
const {
    title,
    description,
    imgSrc,
    pixelArt = false,
    skills,
    averageBrightness,
} = Astro.props;
---

<div class="card__portfolio">
    <img
            src={imgSrc}
            class:list={{ "pixel-art": pixelArt }}
            alt={title}
            crossorigin="anonymous"
            height={130}
            width={332}
            loading="lazy"
            average-brightness={averageBrightness}
    />

    <div class="description__container">
        <h2 class="card__title">{title}</h2>
        <div class="description">
            <p tabindex="0" aria-label={`Description de ${title}`}>{description}</p>

            <div class="skills">
                {
                    skills.map(({ icon, label }) => (
                        <span class="skill" tabindex="0" role="img" aria-label={label}>
                            <iconify-icon class="iconify" icon={icon} aria-hidden="true" />
                            <span class="skill-tooltip" aria-hidden="true">{label}</span>
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</div>
