---
import SocialIcons from '../SocialIcons.astro';
import Title from '../atoms/Title.astro';
import "./about.css"
import "../../styles/global.css"
---

<section id="about" class="about">
    <div class="about__container">
        <img
                class="about__img"
                src={`${import.meta.env.BASE_URL}img/geoffrey-coutant-photo.svg`}
                alt="Portrait of Geoffrey Coutant"
        />

        <div class="about__content">
            <Title margin="1rem" container="About me" />
            <p class="about__text">
                I'm a web developer who enjoys building modern, functional interfaces and bringing ideas
                to life through code and design. Outside work, I like learning new things, playing
                sports, and sometimes coding just for fun. I love animals and originally wanted to
                be a veterinarian. Then I watched my cousin code and decided to give it a try.
                The more I learned about web development, the more I enjoyed it. I chose to pursue
                it and have never regretted that decision. I'm always looking for new challenges
                and ways to grow as a developer.
            </p>
            <SocialIcons width="25" height="25"/>
        </div>
    </div>

</section>
