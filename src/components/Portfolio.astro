---
import Title from './atoms/Title.astro';
import { getPortfolioData} from "@/components/data/portfolioData.js"
import Card from './card-portfolio/CardPortfolio.astro';
import "../styles/global.css"

const visibleProjects = getPortfolioData.filter((project) => !project.showAfterExpand);
const additionalProjects = getPortfolioData.filter((project) => project.showAfterExpand);
---

<section
        id="projets"
        class="flex flex-col w-full  justify-center items-center h-auto min-h-[100dvh]  "
>
    <div class="portfolio__container">
        <Title container="Projets" margin="5%" />
        <div class="portfolio__elements">
            {visibleProjects.map((props) => <Card {...props} />)}
        </div>
        <details class="more-projects">
            <summary>
                <span class="more-label">Voir plus</span>
                <span class="less-label">Voir moins</span>
            </summary>
            <div class="portfolio__elements">
                {additionalProjects.map((props) => <Card {...props} />)}
            </div>
        </details>
    </div>
</section>

<style>
    .more-projects {
        margin: 4rem 0;
    }

    .more-projects summary {
        width: max-content;
        margin: 0 auto;
        padding: 1.1rem 2.2rem;
        border-radius: 100px;
        background: var(--primary);
        color: var(--primary-90);
        font-size: var(--text-x-large);
        cursor: pointer;
        list-style: none;
    }

    .more-projects summary::-webkit-details-marker {
        display: none;
    }

    .more-projects summary:hover {
        opacity: 0.7;
    }

    .more-projects .less-label,
    .more-projects[open] .more-label {
        display: none;
    }

    .more-projects[open] .less-label {
        display: inline;
    }

    .more-projects .portfolio__elements {
        margin-top: 3rem;
    }

    .portfolio__elements {
        max-width: var(--max-width);
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 4rem;
    }
</style>

<script>
    import { getIMGAverageColor } from '../utils/average-img-color/average-img-color';

    const $cards = document.querySelectorAll('.card__portfolio');
    $cards.forEach((card) => {
        const $container = card.querySelector<HTMLDivElement>(
            '.description__container'
        );
        const $img = card.querySelector('img');
        if (!$img || !$container) return;

        const setBg = () => {
            const [rbgString] = getIMGAverageColor($img, 0.7);
            $container.style.background = rbgString;
        };
        setBg();
        $img.onload = setBg;
    });
</script>
