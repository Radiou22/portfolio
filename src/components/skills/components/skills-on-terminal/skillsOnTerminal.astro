---
import TerminalIcon from '../../atoms/terminal-icon/TerminalIcon.astro';
import Terminal from '../terminal/Terminal.astro';
import './skills-on-terminal.css';
---

<Terminal nombre="GeoffreyCoutant">
    <div class="terminal__skills">
        <h2>My Skills</h2>
        <div class="terminal__skills__container">
            <TerminalIcon
                    src={`${import.meta.env.BASE_URL}assets/csharp.svg`}
                    color="#7738ff"
                    name="Csharp"
            />
            <TerminalIcon
                    src={`${import.meta.env.BASE_URL}assets/html.svg`}
                    color="#FF4747"
                    name="Html"
            />
            <TerminalIcon
                    src={`${import.meta.env.BASE_URL}assets/react.svg`}
                    color="#00D1FF"
                    name="React"
            />
            <TerminalIcon src={`${import.meta.env.BASE_URL}assets/javascript.svg`} color="#FFFF00" name="JavaScript" />
            <TerminalIcon src={`${import.meta.env.BASE_URL}assets/css.svg`} color="#00A3FF" name="CSS" />
            <TerminalIcon
                    src={`${import.meta.env.BASE_URL}assets/tailwind.svg`}
                    color="#3F75FF"
                    name="Tailwind"
            />
            <TerminalIcon src={`${import.meta.env.BASE_URL}assets/java.svg`} color="#F89820" name="Java" />
            <TerminalIcon src={`${import.meta.env.BASE_URL}assets/vue.svg`} color="#42B883" name="Vue 3" />
            <TerminalIcon src={`${import.meta.env.BASE_URL}assets/docker.svg`} color="#2496ED" name="Docker" />
        </div>
    </div>
</Terminal>
