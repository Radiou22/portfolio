---
import Title from '../atoms/Title.astro';
import SkillsOnTerminal from './components/skills-on-terminal/skillsOnTerminal.astro';
import './skills.css';
import "../../styles/global.css";
---

<section id="skills">
    <SkillsOnTerminal />
    <div class="text-content">
        <Title container="Skills" />
        <div class="flex flex-wrap gap-3">
            <div class="flex flex-col gap-2">
                <h1 class="text-white underline underline-offset-4 text-3xl">🔧 Languages &amp; Frameworks</h1>
                <p>I'm proficient in HTML, CSS, Tailwind CSS, JavaScript, and C#.</p>
                <p>I have experience with Java, Vue 3, React, Python, and SQL. I continue to explore Angular and PHP.</p>
                <p>I use ASP.NET to build web applications.</p>
            </div>
            <div class="">
                <h1 class="text-white underline underline-offset-4 text-3xl">🖥️ Tools &amp; Environments</h1>
                <p>I'm comfortable with JetBrains IDEs, Git (GitHub and GitLab), Figma, Notion, Slack, Docker, MongoDB, and PostgreSQL.</p>
            </div>
        </div>
    </div>
</section>
