---
import './hero.css';
import { Boton } from '@/components/atoms';
import "../../styles/global.css"
---

<section class="hero">

    <div class="hero__container">
        <div class="text__content">
            <h1 class="hero__title color__gradiente">Geoffrey Coutant</h1>
            <p class="hero__text">
                I've been interested in web development since middle school. I taught myself
                HTML and CSS and discovered how much I enjoy front-end development.
                I'm naturally curious, and exploring different interests keeps me learning.
            </p>
            <Boton href="#about" texto="Learn more"/>
        </div>
        <img
                class="hero__img"
                src={`${import.meta.env.BASE_URL}img/geoffrey-coutant-photo.svg`}
                alt="Geoffrey Coutant"
                width="384"
                height="384"
        />
    </div>
</section>
